{
  "name": "pixelleiste",
  "productName": "PixelLeiste",
  "version": "1.2.0",
  "description": "Steuerung für iPixel-kompatible LED-Leisten (96x16) per Bluetooth LE – Windows, Linux & Android",
  "author": "Phill (phillhf)",
  "homepage": "https://github.com/phillhf/PixelLeiste",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "electron": "npm run build && electron .",
    "dist:win": "powershell -ExecutionPolicy Bypass -File installer/build.ps1",
    "dist:linux": "npm run build && electron-builder --linux deb AppImage --publish never",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug"
  },
  "build": {
    "appId": "de.phill.pixelleiste",
    "productName": "PixelLeiste",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "copyright": "MIT License - Phill (phillhf)",
    "electronLanguages": [
      "de",
      "en-US"
    ],
    "win": {
      "target": [
        "dir"
      ],
      "icon": "installer/app.ico"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "executableName": "pixelleiste",
      "maintainer": "Phill (phillhf) <181326255+phillhf@users.noreply.github.com>",
      "synopsis": "LED-Leisten der iPixel-Color-Familie per Bluetooth steuern",
      "desktop": {
        "Name": "PixelLeiste",
        "Comment": "LED-Leisten per Bluetooth steuern",
        "Keywords": "LED;Bluetooth;iPixel;Laufschrift;"
      }
    },
    "deb": {
      "depends": [
        "bluez",
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ],
      "artifactName": "pixelleiste_${version}_amd64.deb"
    },
    "appImage": {
      "artifactName": "PixelLeiste-${version}-x86_64.AppImage"
    }
  },
  "devDependencies": {
    "@capacitor-community/bluetooth-le": "^7.3.2",
    "@capacitor/android": "^7.6.9",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@playwright/test": "^1.64.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "gifenc": "^1.0.3",
    "gifuct-js": "^2.1.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
