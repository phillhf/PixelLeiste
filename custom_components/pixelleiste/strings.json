{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "description": "Choose the LED panel. Close the iPixel Color / PixelLeiste app first – the panel accepts only one connection at a time.",
        "data": { "address": "Panel" }
      },
      "bluetooth_confirm": {
        "description": "Set up the LED panel {name}?"
      }
    },
    "abort": {
      "already_configured": "This panel is already set up.",
      "no_devices_found": "No LED panel (LED_BLE_…) found. Switch it on, close the phone app and make sure Home Assistant has Bluetooth (adapter or ESPHome Bluetooth proxy) near the panel.",
      "not_supported": "This device is not a supported LED panel."
    }
  },
  "options": {
    "step": {
      "init": {
        "data": {
          "password": "Panel password (6 digits, empty if none)",
          "idle_seconds": "Disconnect after (seconds without commands)"
        },
        "data_description": {
          "idle_seconds": "The panel accepts only one connection. After this time Home Assistant releases it so the phone/PC app can connect."
        }
      }
    },
    "error": { "invalid_password": "The password must be exactly 6 digits." }
  },
  "entity": {
    "light": { "panel": { "name": "Panel" } },
    "text": { "text": { "name": "Text" } },
    "number": { "speed": { "name": "Text speed" } },
    "button": {
      "show_clock": { "name": "Show clock" },
      "sync_time": { "name": "Sync time" }
    },
    "select": {
      "effect": {
        "name": "Text effect",
        "state": {
          "static": "Static", "scroll_left": "Scroll left", "scroll_right": "Scroll right",
          "blink": "Blink", "fade": "Breathe / fade", "snowflake": "Snowflakes"
        }
      },
      "color": {
        "name": "Text colour",
        "state": {
          "white": "White", "red": "Red", "orange": "Orange", "yellow": "Yellow", "green": "Green",
          "cyan": "Cyan", "blue": "Blue", "magenta": "Magenta", "rainbow": "Rainbow"
        }
      },
      "clock_style": { "name": "Clock face" },
      "show_slot": { "name": "Show slot" }
    }
  },
  "selector": {
    "effect": {
      "options": {
        "static": "Static", "scroll_left": "Scroll left", "scroll_right": "Scroll right",
        "blink": "Blink", "fade": "Breathe / fade", "snowflake": "Snowflakes"
      }
    },
    "fit": { "options": { "crop": "Fill (crop)", "fit": "Fit (borders)", "stretch": "Stretch" } },
    "timer_action": { "options": { "start": "Start", "pause": "Pause", "stop": "Stop" } }
  },
  "services": {
    "send_text": {
      "name": "Send text",
      "description": "Shows a text on the panel (pixel font, colour codes like [#ff0000]red[/] possible).",
      "fields": {
        "device_id": { "name": "Panel", "description": "One or more PixelLeiste panels." },
        "text": { "name": "Text", "description": "Up to 255 characters." },
        "effect": { "name": "Effect", "description": "Animation of the text." },
        "color": { "name": "Colour", "description": "Text colour." },
        "background": { "name": "Background", "description": "Optional background colour." },
        "speed": { "name": "Speed", "description": "0–100." },
        "rainbow": { "name": "Rainbow", "description": "0 = off, 1–9 = rainbow styles." },
        "slot": { "name": "Slot", "description": "0 = show only, 1–10 = also save in this slot." }
      }
    },
    "send_image": {
      "name": "Send image",
      "description": "Shows an image or animated GIF, scaled to the panel size.",
      "fields": {
        "device_id": { "name": "Panel", "description": "One or more PixelLeiste panels." },
        "path": { "name": "File", "description": "Path on the Home Assistant host (must be in allowlist_external_dirs, e.g. /config/www)." },
        "url": { "name": "URL", "description": "Alternatively an image address." },
        "fit": { "name": "Fit", "description": "How the image is scaled." },
        "slot": { "name": "Slot", "description": "0 = show only, 1–10 = also save in this slot." }
      }
    },
    "show_clock": {
      "name": "Show clock",
      "description": "Syncs the time and shows a clock face.",
      "fields": {
        "device_id": { "name": "Panel", "description": "One or more PixelLeiste panels." },
        "style": { "name": "Clock face", "description": "1–9." },
        "format_24": { "name": "24-hour", "description": "24-hour format." },
        "show_date": { "name": "Show date", "description": "Also show the date." }
      }
    },
    "show_slot": {
      "name": "Show slot",
      "description": "Shows the content stored in a slot.",
      "fields": {
        "device_id": { "name": "Panel", "description": "One or more PixelLeiste panels." },
        "slot": { "name": "Slot", "description": "1–10." }
      }
    },
    "delete_slot": {
      "name": "Delete slot",
      "description": "Deletes the content of a slot.",
      "fields": {
        "device_id": { "name": "Panel", "description": "One or more PixelLeiste panels." },
        "slot": { "name": "Slot", "description": "1–10." }
      }
    },
    "scoreboard": {
      "name": "Scoreboard",
      "description": "Shows two scores.",
      "fields": {
        "device_id": { "name": "Panel", "description": "One or more PixelLeiste panels." },
        "left": { "name": "Left", "description": "0–99." },
        "right": { "name": "Right", "description": "0–99." }
      }
    },
    "countdown": {
      "name": "Countdown",
      "description": "Starts, pauses or stops the countdown.",
      "fields": {
        "device_id": { "name": "Panel", "description": "One or more PixelLeiste panels." },
        "action": { "name": "Action", "description": "Start, pause or stop." },
        "minutes": { "name": "Minutes", "description": "0–255." },
        "seconds": { "name": "Seconds", "description": "0–59." }
      }
    },
    "stopwatch": {
      "name": "Stopwatch",
      "description": "Starts, pauses or stops the stopwatch.",
      "fields": {
        "device_id": { "name": "Panel", "description": "One or more PixelLeiste panels." },
        "action": { "name": "Action", "description": "Start, pause or stop." }
      }
    },
    "rhythm": {
      "name": "Rhythm effect",
      "description": "Shows the panel's built-in rhythm animation.",
      "fields": {
        "device_id": { "name": "Panel", "description": "One or more PixelLeiste panels." },
        "style": { "name": "Style", "description": "1 or 2." },
        "intensity": { "name": "Intensity", "description": "0–7." }
      }
    },
    "set_orientation": {
      "name": "Set orientation",
      "description": "Rotates or mirrors the display.",
      "fields": {
        "device_id": { "name": "Panel", "description": "One or more PixelLeiste panels." },
        "orientation": { "name": "Orientation", "description": "0 = normal, 1–3 = variants." }
      }
    }
  },
  "exceptions": {
    "not_found": { "message": "Panel {name} is not in Bluetooth range (or the phone app is connected to it)." },
    "connect_failed": { "message": "Could not connect to {name}: {error}" },
    "no_answer": { "message": "Panel {name} did not answer." },
    "password_required": { "message": "Panel {name} is password protected – enter the password in the integration options." },
    "unknown_device": { "message": "Unknown or not loaded PixelLeiste device." },
    "path_not_allowed": { "message": "Home Assistant may not read {path} – add the folder to allowlist_external_dirs." },
    "no_image": { "message": "Please specify a file or a URL." }
  }
}
